# ── Environment ──────────────────────────────────────────────────────────────
# Groq LLM API key — get yours free at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Which Groq model to use (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Sliding window — how many past messages to include in every Groq call (default: 20)
# CONTEXT_WINDOW=20

# Comma-separated allowed origins for CORS (default: * = allow all)
# Production example: ALLOWED_ORIGINS=https://your-portfolio.vercel.app
# ALLOWED_ORIGINS=*

# Qdrant vector DB (optional — not used in current version)
# QDRANT_URL=https://...
# QDRANT_API_KEY=...
